{"symbol":"Ls","class":"DeLevieFiniteLength","formula":"Z = \\frac{\\sqrt{R_{i} R_{r}} \\coth{\\left(d \\sqrt{\\frac{R_{i}}{R_{r}}} \\sqrt{Y \\left(2 j \\pi f\\right)^{n} + 1} \\right)}}{\\sqrt{Y \\left(2 j \\pi f\\right)^{n} + 1}}","summary":"de Levie","n_parameters":5,"n_free_by_default":5,"parameters":[{"symbol":"R_i","unit":"ohm/cm","default":10.0,"lo":0.0,"hi":"inf","fixed":false,"desc":"Ionic resistance"},{"symbol":"R_r","unit":"ohm*cm","default":1.0,"lo":0.0,"hi":"inf","fixed":false,"desc":"Faradaic reaction resistance"},{"symbol":"Y","unit":"S*s^n/cm","default":0.01,"lo":1e-24,"hi":"inf","fixed":false,"desc":"Admittance"},{"symbol":"n","unit":"","default":0.8,"lo":0.0,"hi":1.0,"fixed":false,"desc":"Phase angle in -pi/2 radians"},{"symbol":"d","unit":"cm","default":0.2,"lo":1e-24,"hi":"inf","fixed":false,"desc":"Electrode thickness"}]},
