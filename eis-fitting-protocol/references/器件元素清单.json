{"symbol":"Tlmno","class":"TransmissionLineModelNonblockingOpen","formula":"Z = \\left(\\frac{R_{ct} R_{i}}{\\left(j 2 \\pi f \\frac{1}{\\frac{1}{\\left(R_{ct} Y\\right)^{1 \\frac{1}{n}}}}\\right)^{n} + 1}\\right)^{1 \\cdot \\frac{1}{2}} \\coth{\\left(\\left(\\frac{1}{\\left(\\frac{R_{ct} Y}{L}\\right)^{1 \\frac{1}{n}} \\frac{1}{\\left(L^{2} R_{i} Y\\right)^{1 \\frac{1}{n}}}}\\right)^{\\frac{n}{2}} \\left(\\left(j 2 \\pi f \\frac{1}{\\frac{1}{\\left(R_{ct} Y\\right)^{1 \\frac{1}{n}}}}\\right)^{n} + 1\\right)^{1 \\cdot \\frac{1}{2}} \\right)}","summary":"Non-blocking porous electrode, open","n_parameters":5,"n_free_by_default":4,"parameters":[{"symbol":"R_i","unit":"ohm/m","default":1.0,"lo":0.0,"hi":"inf","fixed":false,"desc":"Ionic resistance"},{"symbol":"R_ct","unit":"ohm*m","default":3.0,"lo":0.0,"hi":"inf","fixed":false,"desc":"Interfacial charge transfer resistance"},{"symbol":"Y","unit":"S*s^n/m","default":0.005,"lo":1e-24,"hi":"inf","fixed":false,"desc":"Interfacial 'admittance"},{"symbol":"n","unit":"","default":0.8,"lo":0.0,"hi":1.0,"fixed":false,"desc":"Phase angle in -pi/2 radians (interface)"},{"symbol":"L","unit":"m","default":1.0,"lo":1e-24,"hi":"inf","fixed":true,"desc":"Pore length"}]},
